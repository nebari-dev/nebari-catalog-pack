}

// Card renders a single pack as a gallery card with an always-visible action
// row (keyboard- and touch-reachable; no hover-reveal).
templ Card(data PageData, p registry.Pack) {
	<article class="card" data-pack={ p.Name } data-category={ p.Category } data-level={ p.Level }>
		<div class="card-media">
			if p.Icon != "" {
				<img class="card-icon" src={ p.Icon } alt={ p.Title() } loading="lazy"/>
			} else {
				<div class="card-icon card-icon-fallback">{ initials(p.Title()) }</div>
			}
		</div>
		<div class="card-body">
			<div class="card-head">
				<h3 class="card-title">{ p.Title() }</h3>
				if p.Level != "" {
					<span class={ levelBadgeClass(p.Level) }>{ p.Level }</span>
				}
			</div>
			if p.Description != "" {
				<p class="card-desc">{ p.Description }</p>
			}
			<div class="card-meta">
				if inf := installed(data, p.Name); inf != nil {
					<span class={ installedBadgeClass(inf.Health) } title={ "sync: " + inf.Sync }>{ installedLabel(inf.Health) }</span>
				}
				if p.Category != "" {
					<span class="badge badge-secondary">{ p.Category }</span>
				}
				if p.Latest != "" {
					<span class="badge badge-version">v{ p.Latest }</span>
				}
				if p.Deprecated {
					<span class="badge badge-warning">deprecated</span>
				}
			</div>
		</div>
		<div class="card-foot">
			if data.InstallEnabled && installed(data, p.Name) != nil {
				<button class="btn btn-sm" disabled title="Already installed in this cluster">Installed</button>
			} else if data.InstallEnabled {
				if len(p.Versions) > 1 {
					<select id={ "ver-" + p.Name } class="select ver-select" name="version" aria-label={ "Version to install for " + p.Title() }>
						for _, v := range p.Versions {
							<option value={ v }>v{ v }</option>
						}
					</select>
				} else {
					<input type="hidden" id={ "ver-" + p.Name } name="version" value={ p.Latest }/>
				}
				<button
					class="btn btn-primary btn-sm"
					hx-post={ asset(data.BasePath, "/install") }
					hx-vals={ installVals(p) }
					hx-include={ "#ver-" + p.Name }
					hx-target={ "#result-" + p.Name }
					hx-swap="innerHTML"
					hx-indicator={ "#spin-" + p.Name }
				>
					if data.DryRun {
						Preview
					} else {
						Install
					}
				</button>
			} else {
				<button class="btn btn-sm" disabled title="Installs disabled (read-only)">Install</button>
			}
			if p.Homepage != "" {
				<a class="btn btn-ghost btn-sm" href={ templ.SafeURL(p.Homepage) } target="_blank" rel="noopener">Docs</a>
			}
			<span id={ "spin-" + p.Name } class="htmx-indicator spinner">installing…</span>
		</div>
		<div class="card-result">
			<div id={ "result-" + p.Name }></div>
		</div>
	</article>
}

// Result is the htmx fragment swapped in after an install attempt, styled as an
// Alert (success/destructive).
templ Result(r InstallResult) {
	if r.OK {
		<div class="result result-ok" role="status">
			<strong>
				if r.DryRun {
					Preview ready
				} else {
					Installed { r.Pack }
				}
			</strong>
			<p>{ r.Message }</p>
			if r.File != "" {
				<p class="muted">{ r.File }
					if r.CommitHash != "" {
						{ " @ " + short(r.CommitHash) }
					}
				</p>
			}
			if r.Health != "" {
				<p class="muted">{ fmt.Sprintf("health: %s · sync: %s", r.Health, r.Sync) }</p>
			}
			if r.Manifest != "" {
				<details>
					<summary>Application manifest</summary>
					<pre class="manifest">{ r.Manifest }</pre>
				</details>
			}
		</div>
	} else {
		<div class="result result-err" role="alert">
			<strong>Failed</strong>
			<p>{ r.Message }</p>
		</div>
	}
}
