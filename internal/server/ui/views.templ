package ui

import (
	"fmt"
	"github.com/nebari-dev/nebari-catalog-pack/internal/registry"
)

// Layout is the full gallery page.
templ Layout(data PageData) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href={ asset(data.BasePath, "/static/app.css") }/>
			<script src={ asset(data.BasePath, "/static/htmx.min.js") }></script>
		</head>
		<body>
			<header class="topbar">
				<div class="brand">
					<span class="logo" aria-hidden="true">
						@nebariSymbol()
					</span>
					<div>
						<h1>{ data.Title }</h1>
						<p class="subtitle">Browse and install Nebari software packs from <code>{ data.RegistryRef }</code></p>
					</div>
				</div>
				<div class="status">
					if !data.InstallEnabled {
						<span class="pill pill-warn" title="Set CATALOG_GITOPS_REPO_URL to enable installs">read-only</span>
					} else if data.DryRun {
						<span class="pill pill-warn">dry-run</span>
					} else {
						<span class="pill pill-ok">install ready</span>
					}
				</div>
			</header>
			if data.Error != "" {
				<div class="banner banner-error">{ data.Error }</div>
			}
			<main class="gallery">
				if len(data.Packs) == 0 {
					<p class="empty">No packs found in the registry.</p>
				}
				for _, p := range data.Packs {
					@Card(data, p)
				}
			</main>
			<footer class="foot">
				<span>{ fmt.Sprintf("%d packs", len(data.Packs)) }</span>
				<span>nebari-catalog-pack</span>
			</footer>
		</body>
	</html>
}

// nebariSymbol renders the Nebari brand mark (from nebari-dev/nebari-design,
// symbol/Nebari-Symbol.svg), inlined so the page makes no runtime external
// requests. Brand colors are baked into the SVG and read on light + dark.
templ nebariSymbol() {
	@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1189.2 642.9" role="img" aria-label="Nebari"><defs><style>.cls-1{fill:#eab54e;}.cls-2{fill:#ba18dd;}.cls-3{fill:#20aaa1;}</style></defs><rect class="cls-3" x="690.6" y="252.36" width="98.12" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="691.81" y="340.35" width="78.69" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="451.52" y="256.25" width="211.04" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="436.14" y="215.14" width="153.58" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="400.48" y="297.32" width="72.3" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="530.98" y="173.9" width="90.32" height="32.11" rx="16.05" ry="16.05"/><rect class="cls-3" x="570.33" y="297.22" width="178.95" height="32.11" rx="16.05" ry="16.05"/><path class="cls-2" d="M652.89,461.02c28.69-6.6,48.29-18.08,61.71-36.15,7.49-10.09,12.41-22.03,15.79-38.45l-37.8,.03c-3.12,13.55-11.43,23.92-24.73,30.85-15.65,8.16-32.85,10-49.49,11.79-1.29,.14-2.59,.28-3.88,.42-4.88,.54-5.76-3.25-6.18-5.07-4.09-17.61-14.18-30.91-29.98-39.54-1.25-.68-2.95-1.81-3.31-3.71-.35-1.85,.74-3.45,1.73-4.63,7.9-9.45,12.43-20.79,15.73-31.02l-39.22,.02c-5.01,10.56-13.38,18.22-25.55,23.39-17.74,7.54-36.29,8.5-55.13,2.87-14.18-4.24-22.72-13.05-25.4-26.2l-37.08-.06c4.68,33.7,24.52,54.98,59.01,63.28,16.47,3.96,33.66,3.71,50.28,3.48l2.59-.04c1.75-.02,3.5-.07,5.25-.11,2.56-.07,5.16-.13,7.76-.13,5.49,0,11.05,.3,16.57,1.52,14.1,3.11,21.39,11.99,21.66,26.38,.23,12.12-4.14,23.26-13.37,34.07-7.34,8.59-16.3,15.36-24.96,21.91-1.34,1.01-2.7,2.04-4.05,3.07l55.93-.07c7.93-9.1,13.5-18,17.01-27.16,1.73-4.52,4.78-5.3,7.83-5.48,12.34-.73,26.9-1.92,41.29-5.23Z"/><path class="cls-1" d="M690.1,235.97c25.65,.12,46.51-20.07,46.71-45.22,.21-25.66-20.26-46.65-45.65-46.81-25.63-.16-46.74,20.49-46.77,45.75-.03,25.42,20.46,46.17,45.71,46.29Z"/></svg>`)
}

// Card renders a single pack as a gallery card.
templ Card(data PageData, p registry.Pack) {
	<article class="card" data-pack={ p.Name }>
		<div class="card-media">
			if p.Icon != "" {
				<img class="card-icon" src={ p.Icon } alt={ p.Title() } loading="lazy"/>
			} else {
				<div class="card-icon card-icon-fallback">{ initials(p.Title()) }</div>
			}
			<div class="card-actions">
				if data.InstallEnabled {
					<button
						class="btn btn-primary"
						hx-post={ asset(data.BasePath, "/install") }
						hx-vals={ installVals(p) }
						hx-target={ "#result-" + p.Name }
						hx-swap="innerHTML"
						hx-indicator={ "#spin-" + p.Name }
					>
						if data.DryRun {
							Preview
						} else {
							Install
						}
					</button>
				} else {
					<button class="btn" disabled title="Installs disabled (read-only)">Install</button>
				}
				if p.Homepage != "" {
					<a class="btn btn-ghost" href={ templ.SafeURL(p.Homepage) } target="_blank" rel="noopener">Docs</a>
				}
			</div>
		</div>
		<div class="card-body">
			<div class="card-head">
				<h3 class="card-title">{ p.Title() }</h3>
				if p.Level != "" {
					<span class={ "tag", "tag-" + p.Level }>{ p.Level }</span>
				}
			</div>
			if p.Description != "" {
				<p class="card-desc">{ p.Description }</p>
			}
			<div class="card-meta">
				if p.Category != "" {
					<span class="chip">{ p.Category }</span>
				}
				if p.Latest != "" {
					<span class="chip chip-ver">v{ p.Latest }</span>
				}
				if p.Deprecated {
					<span class="chip chip-warn">deprecated</span>
				}
			</div>
		</div>
		<div class="card-result">
			<span id={ "spin-" + p.Name } class="htmx-indicator spinner">installing…</span>
			<div id={ "result-" + p.Name }></div>
		</div>
	</article>
}

// Result is the htmx fragment swapped in after an install attempt.
templ Result(r InstallResult) {
	if r.OK {
		<div class="result result-ok">
			<strong>
				if r.DryRun {
					Preview ready
				} else {
					Installed { r.Pack }
				}
			</strong>
			<p>{ r.Message }</p>
			if r.File != "" {
				<p class="muted">{ r.File }
					if r.CommitHash != "" {
						{ " @ " + short(r.CommitHash) }
					}
				</p>
			}
			if r.Health != "" {
				<p class="muted">{ fmt.Sprintf("health: %s · sync: %s", r.Health, r.Sync) }</p>
			}
			if r.Manifest != "" {
				<details>
					<summary>Application manifest</summary>
					<pre class="manifest">{ r.Manifest }</pre>
				</details>
			}
		</div>
	} else {
		<div class="result result-err">
			<strong>Failed</strong>
			<p>{ r.Message }</p>
		</div>
	}
}
