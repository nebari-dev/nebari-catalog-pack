package ui

import (
	"fmt"
	"github.com/nebari-dev/nebari-catalog-pack/internal/registry"
)

// Layout is the full gallery page: top bar, filter toolbar, and the (htmx-
// swappable) gallery grid.
templ Layout(data PageData) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href={ asset(data.BasePath, "/static/app.css") }/>
			<script src={ asset(data.BasePath, "/static/htmx.min.js") }></script>
		</head>
		<body>
			<header class="topbar">
				<div class="brand">
					<span class="logo" aria-hidden="true">
						@nebariSymbol()
					</span>
					<div>
						<h1>{ data.Title }</h1>
						<p class="subtitle">Browse and install Nebari software packs from <code>{ data.RegistryRef }</code></p>
					</div>
				</div>
				<div class="status">
					if !data.InstallEnabled {
						<span class="badge badge-warning badge-uppercase" title="Set CATALOG_GITOPS_REPO_URL to enable installs">read-only</span>
					} else if data.DryRun {
						<span class="badge badge-warning badge-uppercase">dry-run</span>
					} else {
						<span class="badge badge-success badge-uppercase">install ready</span>
					}
				</div>
			</header>
			if data.Error != "" {
				<div class="banner banner-error">{ data.Error }</div>
			}
			@Toolbar(data)
			<div id="gallery">
				@Gallery(data)
			</div>
			<footer class="foot">
				<span>{ fmt.Sprintf("%d packs", data.Total) }</span>
				<span>nebari-catalog-pack</span>
			</footer>
		</body>
	</html>
}

// Toolbar renders the search box plus category/level/sort controls. Each
// control issues an htmx GET to /gallery including the whole toolbar, so the
// filters combine and only the grid is re-rendered.
templ Toolbar(data PageData) {
	<div class="toolbar">
		<input
			class="field-input field-search"
			type="search"
			name="q"
			value={ data.Filters.Query }
			placeholder="Search packs…"
			aria-label="Search packs"
			hx-get={ asset(data.BasePath, "/gallery") }
			hx-trigger="input changed delay:250ms, search"
			hx-target="#gallery"
			hx-swap="innerHTML"
			hx-include="closest .toolbar"
		/>
		if len(data.Filters.Categories) > 0 {
			<select class="select" name="category" aria-label="Filter by category" hx-get={ asset(data.BasePath, "/gallery") } hx-trigger="change" hx-target="#gallery" hx-include="closest .toolbar">
				<option value="" selected?={ data.Filters.Category == "" }>All categories</option>
				for _, c := range data.Filters.Categories {
					<option value={ c } selected?={ data.Filters.Category == c }>{ c }</option>
				}
			</select>
		}
		if len(data.Filters.Levels) > 0 {
			<select class="select" name="level" aria-label="Filter by maturity level" hx-get={ asset(data.BasePath, "/gallery") } hx-trigger="change" hx-target="#gallery" hx-include="closest .toolbar">
				<option value="" selected?={ data.Filters.Level == "" }>All levels</option>
				for _, l := range data.Filters.Levels {
					<option value={ l } selected?={ data.Filters.Level == l }>{ l }</option>
				}
			</select>
		}
		<select class="select" name="sort" aria-label="Sort" hx-get={ asset(data.BasePath, "/gallery") } hx-trigger="change" hx-target="#gallery" hx-include="closest .toolbar">
			<option value="name" selected?={ data.Filters.Sort == "name" || data.Filters.Sort == "" }>Name (A–Z)</option>
			<option value="maturity" selected?={ data.Filters.Sort == "maturity" }>Maturity</option>
			<option value="category" selected?={ data.Filters.Sort == "category" }>Category</option>
		</select>
	</div>
}

// Gallery is the grid of cards plus a result count. It is rendered both inside
// the full page and as the htmx fragment swapped into #gallery on filter.
templ Gallery(data PageData) {
	<div class="results-head">
		<span class="toolbar-count">
			if len(data.Packs) == data.Total {
				{ fmt.Sprintf("%d packs", data.Total) }
			} else {
				{ fmt.Sprintf("%d of %d packs", len(data.Packs), data.Total) }
			}
		</span>
	</div>
	<main class="gallery">
		if len(data.Packs) == 0 {
			<p class="empty">No packs match your filters.</p>
		}
		for _, p := range data.Packs {
			@Card(data, p)
		}
	</main>
}

// nebariSymbol renders the Nebari brand mark (from nebari-dev/nebari-design,
// symbol/Nebari-Symbol.svg), inlined so the page makes no runtime external
// requests. Brand colors are baked into the SVG and read on light + dark.
templ nebariSymbol() {
